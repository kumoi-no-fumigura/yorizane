  {
   "seq": "2",
   "text": "秋の夜に雪むらきゆとみゆるかな籬に咲る白菊の花",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "たなはたの待つる程のくるしさとあかぬ別といつれまされる",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "いつれをか思ひますらむ七夕はあふ嬉しさとあはぬつらさと",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "七夕に心はかすとおもはねと暮行空のうれしきはなそ",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "獨ねやいとゝ淋しきさほしかのあさふすをゝくすの浦風",
   "kana": "",
   "speaker": "〓とになひくそみゆる秋の夜の月",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "忘らるゝ我みくまのゝはまゆふを何しに人にとへといひけん",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "みくまのゝうらみ所もなき物をとへと契りし程のすきねは",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "花をみる春はやみたになかりせはけふも暮ぬと歎かましやは",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "ふらかはのけふの契りを違へすは春のみとふと人やおもはむ",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "ゐてにゆく人にもあらて我宿におりてそみつる山ふきの花",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "散頃はちるをみつゝもなくさめつ花なき春のなをや殘らん",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "なかれつる瀧の水たになかりせは散にし花をまたもみましや",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "行春ををしむ心はちり殘る花みる人やのとけかるらん",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "曇なき空も霞にかすみつゝ光りにあかめ春のよの月",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "ねの日してけふ引そむる姫小松いくたひ春にあはむとすらん",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "夏山のをちにたな引白雲の立出てみねと成にけるかな",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "たゝくともしはしとちなん天のとはあくれはかへる水雞成鳬",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "ゆふやみに鳴てすく成郭公かへらぬ時も道なたかへそ",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "夏の夜はこのした渡る風の音も夕かけにこそ涼しかりけれ",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "郭公きなかぬさきに明にけりなとなか月にまたす成けん",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "一こゑのおほつかなきに郭公きゝてのゝちもねられさりけり",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "五月雨はおほつかなきを時鳥さやかに月のかけにきゝつる",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "みな人もけふや衣はかへつらむひとへに夏のきぬとおもへは",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "たちて行春をおしめと夏衣きたるはこれもなつかしき哉",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "いとゝしくやへ山吹は匂はなんはるさへ深くさけるしるしに",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "ときはなる松にかゝれる藤の花千とせのはるに匂ふへきかな",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "卯花のさかりつきなん山里はすむ人やみの心地こそせめ",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "けふみれはかけて歸らぬ人そなき葵そ神のしろしなりける",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "五月雨をまたは早苗やおいぬへき水ひくたこの急かしきかな",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "郭公きなく道たにしるからはあふ坂まてもゆくへき物を",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "古里はとひくる人もなかりけりたゝく水鷄の音はかりして",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "こちくるを我友とのみみゆる哉よをへて風のおとしたえねは",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "かきなかす水もにこらぬ宿なれは移れる月のかけさへそすむ",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "待こひてきゝやしつると郭公人にさへこそとはまほしけれ",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "暮はてゝ人のまれらになるまゝに入相のかね聲そきこゆる",
   "kana": "",
   "speaker": "",
   "page": 369,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "とこ夏の露をきわたる朝ほらけ錦に玉をかけてこそみれ",
   "kana": "",
   "speaker": "故侍中左金吾家集",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "夏の日になるまてとけぬ冬こほり春立風やよきて吹らむ",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "秋をまつ花をほりうゑてみる人は夏をすくすそ久しかりける",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "秋風はまた夏なから吹にけり月のたつをもなにかまつへき",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "秋立てかとたのいなはうちなひきをとめつらしき秋の初風",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "初秋の空さへすゝしき月影は人の心もすみまさりけり",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "さやかなる月をのみやは眺めつる曇しよはもまたれし物を",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "待ほとの久しからすは七夕のけさの分れは歎かさらまし",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "あかなくにあまつ空なる月影をいけのしに移てそみる",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "秋のよの空にくまなき月影はなけきやす覽かつらきの神",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "くる人にいくたひあひぬ白河の渡りにすめる秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "秋〓とに花を宮こにほりうへてけふそ千とせのはしめ成ける",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "秋とと妻こひわひて鳴鹿はきりたつ山やふしうかるらん",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "秋風にこゑうちそふるから衣たかさと人としらすも有かな",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "朝きりを野へに分つるかひもなしけふさへ花にあかて暮ぬる",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "靑やきの枝はかりにも春暮てにたる花なき宿の秋はき",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "紅にふもとのかはのうつるまて峯のもみちの深くも有哉",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "歸るさは急かれぬ哉花のかのひをへてかはる野へにきぬれは",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "空にのみ聲のきこゆる鴈金はあまの河原にやとやかるらん",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "夜をかさね鹿のね高くきこゆなり小萩か原やしほれしぬらん",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "河霧にをちみえぬまて立にけり何れかよとのわたり成らん",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "おいせしとおもて〓〓にのこへとも霜いたゝけろ白菊の花",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "岸による蘆かり小舟なかりせは雪とのみこそみるへかりけれ",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "九重にうつしうへつるしるしには久しく句へ野への秋萩",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "秋萩のけふまてちらぬ物ならは紅葉の色もまさらましやは",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "つれよりものとけき空にみつる哉世を長つきにすめる月影",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "吉野山紅葉ちるらし我宿の木すゑゆるきて秋風そ吹",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "宮城のゝけさの白露ひまなくてかせはたまをや吹みたるらん",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "花みんとしめしかひなく秋きりのあしたの原を立渡る哉",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "花薄ほにいてゝなひく秋風に野へはさながら波そ立ける",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "くらきよもをりつへらなり我宿のをもしろきまて咲る白菊",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "小山田の秋はてかたにみゆるかな殘すくなきかりやしつらむ",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "すきかたき色とみゆれは紅葉〓の深き山路にこまをとめつる",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "白雲にあとはきえつゝとふ鴈のきにける聲を空にしるかな",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "聲しけみさをしかのなく秋のよはきく人さらに驚かれぬる",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "色〓にうつろふ菊のなかりせはなにをかみまし秋のかたみに",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "しめゆはぬきりの籬のこ萩原またあかなくに日も暮にけり",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "けさみれは色つきにけり小萩原花こそ秋のしるし成けれ",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "我宿に花を殘さすうつしうへて鹿のねきかぬ野へとなしつる",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "月影のふもとの里にをそきかな峯を越てそまつかへりける",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "朝夕にあらしのはらふ庭の面に散しつもれる紅葉成けり",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "我宿は花のやとりとなりにけりのへの主と人やみるらん",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "定めなき空にもあるかなみるほとに時雨は曇る冬のよの月",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "春秋の花といふ花の色ノ〓を殘れる菊にうつしてそみる",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "秋風のをきのはすくろ夕暮に人まつひとの心をそしる",
   "kana": "",
   "speaker": "",
   "page": 370,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "水のおもによもの山へもうつりつゝ鏡とみゆる池の上かな",
   "kana": "",
   "speaker": "故侍中左金吾家集",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "昔よりをときく高き泉かな人のせいるゝ水ならねとも",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "色深く小高き松はなりにけりいくよそめつるみとりなるらむ",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "梢より散たにをしき紅葉はの風の音さへまれに成行",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "月影のみるにくまなき秋のよはたのめぬ人もまたれこそすれ",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "あさまたき人のふみ行道しはのあとみゆはかり置る霜かな",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "秋ふかくなり行まゝにきくの花日にそへてこそ色は染けれ",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "から衣もうつ聲しけくきこゆなり寒きあらしの音にそへつゝ",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "よとゝもに空にきこゆる鴈金はしらぬ雲地も嵐とそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "暮て行空に心そとまりけるけふらし秋のせきと思はん",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "月影をまつに夜更ぬ秋のよはあくるほとたにひさしからなん",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "紅葉はの散し殘れは山里に秋をとゝめてみるこゝ地する",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "秋とにさやけき月は今宵こそ我みつるよのためし也けれ",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "紅葉〓は我衣てにかくれともきてみる人のあかすも有かな",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "けさみれは河邊の氷りひまなくてかはせにのみそ波は立ける",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "河水にまかせて落すいかたしはさして行衞もしられさりけり",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "雪ふれは松こそいたくおいにけれ千歳の冬をつみやしつらん",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "月影もいはなみたかきあしろにはうすき氷のよるかとそみる",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "いとゝしく紅葉ちりしく庭の上にひかりをそふる冬のよの月",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "このはちる宿はきゝわくとそなき時雨するよも時雨せぬよも",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "打かさねいくよの風か立つらんこの葉そ苔の衣なりける",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "夜を重ねふけゐの浦にあまのたく思ひありとは人もしらしな",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "思ひかねしらぬ磯へに事寄てうちいつる波のかひもあらなん",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "深綠思ひそめては久しきをいかてかみましすみよしの松",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "おとは山谷の下水おとにのみきゝて渡らぬ袖もぬれけり",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "思ふ〓鳴鳴のうらにすまぬみのしほたれ衣かはくよそなき",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "しるへする人たにみえぬ奥山のふみゝぬ道にまよふころかな",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "年ふれといはぬ思ひはかひそなき人にしらるゝ煙ならねは",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "いかにせん戀ちにまよふ郭公しのひに鳴てすこす頃かな",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "我〓くく戀せん人のまたあらはいかにかするととふへき物を",
   "kana": "",
   "speaker": "",
   "page": 371,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
 ],
